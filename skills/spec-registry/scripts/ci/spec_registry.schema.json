{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Council SPEC Registry (proposed)",
  "type": "object",
  "required": ["schema_version", "specs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "registry_state": {"type": "string"},
    "as_of": {"type": "string"},
    "note": {"type": "string"},
    "specs": {"type": "array", "items": {"$ref": "#/$defs/spec"}}
  },
  "$defs": {
    "spec": {
      "type": "object",
      "required": ["spec_id","title","path","status","approved_by","approval_ref","spec_sha256","dependencies","verify_paths","qa_paths","risk"],
      "properties": {
        "spec_id": {"type": "string", "pattern": "^SPEC-[0-9]+$"},
        "title": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "status": {"enum": ["DISCOVERED", "DRAFT", "IN_REVIEW", "APPROVED", "IMPLEMENTING", "VERIFIED", "FROZEN", "SUPERSEDED", "CANCELLED"]},
        "approved_by": {"type": ["string", "null"]},
        "approval_ref": {"type": ["string", "null"]},
        "spec_sha256": {"anyOf": [{"type":"string","pattern":"^[0-9a-f]{64}$"},{"type":"null"}]},
        "dependencies": {"type":"array", "items":{"type":"string"}},
        "verify_paths": {"type":"array", "items":{"type":"string"}},
        "qa_paths": {"type":"array", "items":{"type":"string"}},
        "risk": {"enum":["LOW","MEDIUM","HIGH","CRITICAL"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
